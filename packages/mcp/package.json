{
  "name": "@forgewisp/mcp",
  "version": "0.7.0",
  "description": "Model Context Protocol (MCP) client support for Forgewisp agents — expose an MCP server's tools as agent FunctionDefinitions",
  "license": "MIT",
  "author": "Angelo Cavallo",
  "homepage": "https://github.com/forgewisp/forgewisp-core/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgewisp/forgewisp-core.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/forgewisp/forgewisp-core/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/forgewisp"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.mjs src tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependencies": {
    "@forgewisp/core": "workspace:^"
  },
  "devDependencies": {
    "@forgewisp/core": "workspace:^",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "ai-agent",
    "function-calling",
    "tool-use",
    "forgewisp",
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "streamable-http",
    "oauth",
    "pkce",
    "claude",
    "anthropic",
    "typescript"
  ]
}
