{
  "name": "@forgewisp/bundled-tools",
  "version": "0.6.5",
  "description": "Browser-effects tool catalog for AI agents — clipboard, geolocation, UUIDs, hashing, base64, QR codes, and more. Forgewisp-ready, safe by default.",
  "license": "MIT",
  "author": "Angelo Cavallo",
  "homepage": "https://github.com/forgewisp/forgewisp-core/tree/main/packages/bundled-tools#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgewisp/forgewisp-core.git",
    "directory": "packages/bundled-tools"
  },
  "bugs": {
    "url": "https://github.com/forgewisp/forgewisp-core/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/forgewisp"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.mjs src tests"
  },
  "dependencies": {
    "@forgewisp/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0",
    "jsdom": "^25.0.0"
  },
  "keywords": [
    "ai-agent",
    "function-calling",
    "tool-use",
    "forgewisp",
    "bundled-tools",
    "browser",
    "web-apis",
    "clipboard",
    "geolocation",
    "uuid",
    "hashing",
    "base64",
    "qrcode",
    "localstorage",
    "sessionstorage",
    "typescript"
  ]
}
