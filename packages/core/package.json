{
  "name": "@forgewisp/core",
  "version": "0.6.5",
  "description": "Safe, function-calling AI agents for the browser",
  "license": "MIT",
  "author": "Angelo Cavallo",
  "homepage": "https://github.com/forgewisp/forgewisp-core/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgewisp/forgewisp-core.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/forgewisp/forgewisp-core/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/forgewisp"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.mjs src tests"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "ai-agent",
    "ai",
    "llm",
    "agent",
    "function-calling",
    "tool-use",
    "tool-calling",
    "json-schema",
    "openai",
    "streaming",
    "browser",
    "typescript",
    "audit-log"
  ]
}
